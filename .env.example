# Copy this file to .env (in this folder) and fill in your own keys. Never commit .env.
OPENAI_API_KEY=
FEATHERLESS_API_KEY=
ELEVENLABS_API_KEY=

# Optional. Your cloned voice; a premade voice is used if empty.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Any chat model listed on featherless.ai
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
TARGET_LANGUAGE=Korean

# Optional error tracking: paste the DSN from your Sentry project
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
