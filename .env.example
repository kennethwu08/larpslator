# Copy this file to .env (in this folder) and fill in your own keys. Never commit .env.
OPENAI_API_KEY=
FEATHERLESS_API_KEY=
ELEVENLABS_API_KEY=

# Optional. Your cloned voice's id; normally set by voice setup on the dashboard instead.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Translation model on featherless.ai, and the one used if it fails
FEATHERLESS_MODEL=mistralai/Mistral-Small-3.2-24B-Instruct-2506
FEATHERLESS_FALLBACK_MODEL=mistralai/Mistral-Nemo-Instruct-2407
TARGET_LANGUAGE=Korean

# Optional error tracking: paste the DSN from your Sentry project
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
